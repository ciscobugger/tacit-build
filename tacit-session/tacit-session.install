# Tacit's updates on (session/updates: the background download, the install while the computer restarts), and a mirror
# list with a server in it
post_install() {
	systemctl preset tacit-fetch-updates.timer tacit-system-update.service >/dev/null 2>&1 || true
	_mirrors
	_nvidia
}
post_upgrade() {
	post_install
}
# a list without one server (the package's own has every line commented out) left Arch's repos with none, and nothing
# could install or update: Arch's worldwide mirrors, as tacit-install writes them
_mirrors() {
	local m=/etc/pacman.d/mirrorlist
	grep -q '^Server' "$m" 2>/dev/null && return
	if [ "$(uname -m)" = aarch64 ]; then
		echo 'Server = http://mirror.archlinuxarm.org/$arch/$repo' > "$m"
	else
		printf '%s\n' 'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch' 'Server = https://fastly.mirror.pkgbuild.com/$repo/os/$arch' > "$m"
	fi
}

# An NVIDIA display card: its video memory kept across sleep, by NVIDIA's own suspend services (NVIDIA's and the Arch
# wiki's setup). Off, sleep lost what the card held and Hyprland could die on waking (an RTX 4050 laptop, Discord
# 2026-10-20: both services disabled). A computer without the card, or without the driver, is left alone.
_nvidia() {
	local d card=0
	for d in /sys/bus/pci/devices/*; do
		[ "$(cat "$d/vendor" 2>/dev/null)" = 0x10de ] && case "$(cat "$d/class" 2>/dev/null)" in 0x03*) card=1 ;; esac
	done
	[ "$card" = 1 ] && [ -e /usr/lib/systemd/system/nvidia-suspend.service ] || return 0
	# done before (by an earlier upgrade or by Setup): the person's own choice since then stands
	local conf=/etc/modprobe.d/tacit-nvidia-sleep.conf
	[ -e "$conf" ] && return 0
	printf '%s\n' '# Tacit (tacit-session): NVIDIA video memory kept across sleep, for nvidia-suspend/-hibernate/-resume' \
		'options nvidia NVreg_PreserveVideoMemoryAllocations=1 NVreg_TemporaryFilePath=/var/tmp' > "$conf"
	systemctl enable nvidia-suspend.service nvidia-hibernate.service nvidia-resume.service >/dev/null 2>&1 || true
}
