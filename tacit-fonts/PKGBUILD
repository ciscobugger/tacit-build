# Tacit: Tacit Sans (with its Compact, Condensed and Display cuts), Tacit Mono and Tacit Code. Modified SIL Open Font
# License fonts (Onest, Readex Pro, Google Sans Code); the licences and FONTLOG travel with them.
pkgname=tacit-fonts
pkgver=1.0.0
pkgrel=1
pkgdesc="Tacit: Tacit Sans, Mono and Code"
arch=('any')
url="https://github.com/ciscobugger/tacit-font"
license=('OFL-1.1')
makedepends=('git')
source=("git+https://github.com/ciscobugger/tacit-font.git#tag=v$pkgver")
sha256sums=('SKIP')

package() {
	cd tacit-font/dist
	install -Dm644 -t "$pkgdir/usr/share/fonts/tacit" *.ttf
	install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" OFL-*.txt
	install -Dm644 FONTLOG.md -t "$pkgdir/usr/share/doc/$pkgname"
}
