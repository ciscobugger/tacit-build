#!/bin/bash
# tools/publish-source [version]: Tacit's public source, commit by commit (owner, 2026-10-21; until 1.0.1 one clean copy
# per release, 2026-10-17). Every commit of each private repo since the last one published goes into its public repo as
# a commit of its own: the same message and dates, by "Tacit", its committed files only (no uncommitted work). A part
# with no licence gets the GPL-3.0 its packages declare, the public README goes over the part's own (which becomes
# DEVELOPING.md), and the cloud project's name is taken out. Nothing is pushed while a commit names the owner's own
# address or holds what looks like a key. With a version, the release is tagged v<version> on top.
#
# Which private commit each public repo has reached: ~/.config/tacit-packages/public-sources ("<public name> <sha>"),
# the private side's record. The private repos stay the working ones.
# DRY=1: the public commits are made in a local copy, shown, and neither pushed nor recorded; a repo not yet on
# GitHub is not created. ONLY=<public name> publishes just that repo.
set -eu
version=${1:-}
me=$(gh api user -q .login)
email="$(gh api user -q .id)+$me@users.noreply.github.com"
licence=$HOME/.config/quickshell/tacit/LICENSE
public=$(dirname "$(readlink -f "$0")")/public
state=$HOME/.config/tacit-packages/public-sources
# in pieces, so this file passes its own check
owner_mail="xizko""55" project="himilo""-hoy"
keys='AIza[0-9A-Za-z_-]{35}|sk-(ant-)?[A-Za-z0-9_-]{32,}|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{40,}|xox[bpas]-[A-Za-z0-9-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'

# the work tree $1 as private commit $3 of repo $2 has it, made public
fill() {
    local w=$1 src=$2 c=$3
    find "$w" -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf {} +
    git -C "$src" archive "$c" | tar -x -C "$w"
    [ -e "$w/LICENSE" ] || cp "$licence" "$w/LICENSE"
    # the public README, written for people rather than developers (tools/public/<name>.md, with its pictures in
    # tools/public/docs); the part's own README, which is for building it, goes on as DEVELOPING.md
    if [ -f "$public/$name.md" ]; then
        [ -e "$w/README.md" ] && mv "$w/README.md" "$w/DEVELOPING.md"
        cp "$public/$name.md" "$w/README.md"
        grep -o 'docs/[A-Za-z0-9._-]*' "$w/README.md" | while read -r f; do mkdir -p "$w/docs"; cp "$public/$f" "$w/$f"; done
    fi
    [ -e "$w/README.md" ] || printf '%s\n' "$readme" > "$w/README.md"
    # what every public repo has for contributors (tools/public/common: CONTRIBUTING.md, the issue forms, the pull
    # request template and its sign-off check), the issue forms pointing at this repo's own security form
    cp -r "$public/common/." "$w/"
    sed -i "s|{repo}|$me/$name|g" "$w/.github/ISSUE_TEMPLATE/config.yml"
    # what coding agents read first (tools/public/agents/<name>.md), and a CLAUDE.md that points Claude Code at it
    if [ -f "$public/agents/$name.md" ]; then
        cp "$public/agents/$name.md" "$w/AGENTS.md"
        printf '@AGENTS.md\n' > "$w/CLAUDE.md"
    fi
    grep -rlI --null --exclude-dir=.git "$project" "$w" | xargs -0 -r sed -i "s/$project/YOUR-PROJECT/g"
}

publish() {
    local src=$1 desc=$3
    name=$2 readme=$4
    [ -z "${ONLY:-}" ] || [ "$ONLY" = "$name" ] || return 0    # ONLY=<public name>: just that repo
    local base w n=0 last first=
    base=$(sed -n "s/^$name //p" "$state" 2>/dev/null)
    w=$(mktemp -d)
    if gh repo view "$me/$name" >/dev/null 2>&1; then
        [ -n "$base" ] || { echo "publish-source: $state names no private commit $name has reached" >&2; exit 1; }
        git clone -q "https://github.com/$me/$name.git" "$w" 2>/dev/null
    else
        # a repo published for the first time: made only when this is not a dry run (DRY never creates anything on
        # GitHub), and its first public commit is one clean copy of the private repo as it is now
        [ -n "${DRY:-}" ] || gh repo create "$me/$name" --public --description "$desc" --homepage https://tacitos.co >/dev/null
        git -C "$w" init -q
        git -C "$w" remote add origin "https://github.com/$me/$name.git"
        base=$(git -C "$src" rev-parse HEAD)
        first=1
    fi
    last=$base
    if [ -n "$first" ]; then
        fill "$w" "$src" "$base"
        if grep -rqI --exclude-dir=.git -e "$owner_mail" -e "$project" "$w"; then
            echo "publish-source: $name still names the owner's address or cloud project; nothing pushed" >&2
            grep -rlI --exclude-dir=.git -e "$owner_mail" -e "$project" "$w" >&2 || true
            exit 1
        fi
        if git -C "$src" grep -qE "$keys" "$base" -- . 2>/dev/null; then
            echo "publish-source: $name has what looks like a key; nothing pushed" >&2
            exit 1
        fi
        git -C "$w" add -A
        git -C "$w" -c user.name=Tacit -c user.email="$email" commit -q -m "$name, first public version"
        n=1
    fi
    for c in $( [ -n "$first" ] || git -C "$src" rev-list --reverse --first-parent "$base..HEAD"); do
        fill "$w" "$src" "$c"
        local msg
        msg=$(git -C "$src" log -1 --format=%B "$c" | sed "s/$project/YOUR-PROJECT/g")
        if grep -rqI --exclude-dir=.git -e "$owner_mail" -e "$project" "$w" || grep -q "$owner_mail" <<<"$msg"; then
            echo "publish-source: $name at ${c:0:7} still names the owner's address or cloud project; nothing pushed" >&2
            grep -rlI --exclude-dir=.git -e "$owner_mail" -e "$project" "$w" >&2 || true
            exit 1
        fi
        if git -C "$src" show --format= "$c" | grep '^+' | grep -qE "$keys"; then
            echo "publish-source: $name at ${c:0:7} adds what looks like a key; nothing pushed" >&2
            exit 1
        fi
        git -C "$w" add -A
        last=$c
        git -C "$w" diff --cached --quiet && continue    # nothing that is published changed
        # a commit taken from a public pull request (tools/take-pr: it carries "Public-PR:") keeps its author, the
        # contributor; every other commit is Tacit's
        local an=Tacit ae=$email
        if git -C "$src" log -1 --format=%B "$c" | grep -q '^Public-PR: '; then
            an=$(git -C "$src" log -1 --format=%an "$c"); ae=$(git -C "$src" log -1 --format=%ae "$c")
        fi
        GIT_AUTHOR_NAME=$an GIT_AUTHOR_EMAIL=$ae \
        GIT_AUTHOR_DATE=$(git -C "$src" log -1 --format=%aI "$c") GIT_COMMITTER_DATE=$(git -C "$src" log -1 --format=%cI "$c") \
            git -C "$w" -c user.name=Tacit -c user.email="$email" commit -q -F - <<<"$msg"
        n=$((n + 1))
    done
    # the public README, its pictures or the contributor files changed with no new commit of the part: that change alone
    if [ "$n" = 0 ]; then
        fill "$w" "$src" "$last"
        git -C "$w" add -A
        if ! git -C "$w" diff --cached --quiet; then
            git -C "$w" -c user.name=Tacit -c user.email="$email" commit -q -m "Public README and contributor files updated"
            n=1
        fi
    fi
    git -C "$w" branch -M main
    local range=origin/main..main
    [ -n "$first" ] && range=main
    if [ -n "${DRY:-}" ]; then
        echo "$name: $n commits made in $w (DRY: nothing created or pushed)"
        git -C "$w" log --format='  %ad  %an  %s' --date=short "$range" | cut -c1-150
        git -C "$w" log --format='%(trailers:key=Public-PR,valueonly,separator=)' "$range" | grep . | sort -u | sed 's/^/  would close /' || true
        return
    fi
    # the pull requests these commits came from, each with its public commits
    local prs
    prs=$(git -C "$w" log --reverse --format='%(trailers:key=Public-PR,valueonly,separator=)%x09%H' "$range" | grep -v '^\s' || true)
    [ "$n" -gt 0 ] && git -C "$w" push -q -u origin main
    for pr in $(cut -f1 <<<"$prs" | grep "^$me/$name#" | sort -u); do
        local links
        links=$(grep -F "$pr"$'\t' <<<"$prs" | cut -f2 | sed "s|^|https://github.com/$me/$name/commit/|")
        gh pr comment "${pr#*#}" -R "$me/$name" --body "$(printf 'Thank you. This is in Tacit now, under your name:\n\n%s\n\nIt ships in the next release.' "$links")" >/dev/null
        gh pr close "${pr#*#}" -R "$me/$name" >/dev/null
        echo "$name: closed $pr with its commits"
    done
    if [ -n "$version" ] && ! git -C "$w" rev-parse -q --verify "refs/tags/v$version" >/dev/null; then
        git -C "$w" -c user.name=Tacit -c user.email="$email" tag -a "v$version" -m "Tacit $version"
        git -C "$w" push -q origin "v$version"
    fi
    if grep -q "^$name " "$state" 2>/dev/null; then sed -i "s/^$name .*/$name $last/" "$state"; else echo "$name $last" >> "$state"; fi
    echo "$name: $n commits$([ -n "$version" ] && echo ", tagged v$version") — https://github.com/$me/$name"
    rm -rf "$w"
}

publish "$HOME/.config/quickshell/tacit" tacit \
    "Tacit's desktop and apps: the shell, notch, search, Setup, Settings, Pinax, Graphis, Viewer and Praxis" \
    "# Tacit"
publish "$HOME/dev/browser" thyris \
    "Thyris, Tacit's browser, on Chromium's engine (CEF)" \
    "$(printf '# Thyris\n\nTacit'"'"'s browser, on Chromium'"'"'s engine (CEF). Part of [Tacit](https://tacitos.co).\n\nLicence: GPL-3.0 (LICENSE).')"
publish "$HOME/dev/tacit-packages" tacit-build \
    "How Tacit is built: its Arch packages, the ISO and the installer's test computer" \
    "# tacit-build"
# the design kit and its example app (public since 2026-10-25, the owner's go)
publish "$HOME/dev/tacit-kit" tacit-kit \
    "Tacit.Kit: the parts Tacit's apps are made of, a QML module for Quickshell apps; the guide is design.tacitos.co" \
    "# Tacit Kit"
publish "$HOME/dev/tacit-music-example" tacit-music-example \
    "A music player made only of Tacit.Kit's parts: an example to build your own app on" \
    "# Music example"
