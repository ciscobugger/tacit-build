# Tacit: the processor's power mode, chosen for the charger and for the battery (Settings > Battery).
pkgname=tacit-cpu-policy
pkgver=0.2.0
pkgrel=1
pkgdesc="Tacit: power mode for the charger and the battery"
arch=('any')
url="https://github.com/ciscobugger/tacit-cpu-policy"
license=('GPL-3.0-or-later')
depends=('bash' 'systemd')
makedepends=('git')
install=tacit-cpu-policy.install
source=("git+https://github.com/ciscobugger/tacit-cpu-policy.git#tag=v$pkgver" "80-tacit-cpu-policy.preset")
sha256sums=('SKIP' 'SKIP')

package() {
	cd tacit-cpu-policy
	install -Dm755 tacit-cpu-policy "$pkgdir/usr/bin/tacit-cpu-policy"
	install -Dm644 91-tacit-cpu-policy.rules "$pkgdir/usr/lib/udev/rules.d/91-tacit-cpu-policy.rules"
	install -Dm644 tacit-cpu-policy.service tacit-cpu-policy.path -t "$pkgdir/usr/lib/systemd/system/"
	install -Dm644 tacit-cpu-policy.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/tacit-cpu-policy.conf"
	install -Dm755 tacit-cpu-policy.sleep "$pkgdir/usr/lib/systemd/system-sleep/tacit-cpu-policy"
	install -Dm644 "$srcdir/80-tacit-cpu-policy.preset" "$pkgdir/usr/lib/systemd/system-preset/80-tacit-cpu-policy.preset"
}
