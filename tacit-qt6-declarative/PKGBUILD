# Tacit: Qt Quick with Tacit's text rendering (tacit-text-gamma.patch in the text shaders: one gamma knob shared with
# Opsis, GTK and foot). Arch's qt6-declarative recipe at 6.12.0-1 (Antonio Rojas, Felix Yan, Andrea Scarpino) plus the
# patch; it replaces qt6-declarative and must be rebuilt for every Qt release Arch ships.
pkgname=tacit-qt6-declarative
_pkgver=6.12.0
pkgver=6.12.0
pkgrel=1
arch=('aarch64' 'x86_64')
url='https://github.com/ciscobugger/tacit-text'
license=('GPL-3.0-only' 'LGPL-3.0-only' 'LicenseRef-Qt-Commercial' 'Qt-GPL-exception-1.0')
pkgdesc="Tacit: Qt's QML and Quick classes with Tacit's text"
depends=('glibc' 'libgcc' 'libstdc++' "qt6-base=$_pkgver")
makedepends=('cmake' 'git' 'ninja' 'python' 'qt6-languageserver' 'qt6-shadertools' 'qt6-svg' 'vulkan-headers')
optdepends=('qt6-svg: for QtQuickVectorImage and svgtoqml')
provides=("qt6-declarative=$_pkgver")
conflicts=('qt6-declarative')
_pkgfn=qtdeclarative
source=("git+https://code.qt.io/qt/$_pkgfn#tag=v$_pkgver"
        "tacit-text::git+https://github.com/ciscobugger/tacit-text.git#commit=4a94f7c")
sha256sums=('SKIP' 'SKIP')

prepare() {
	patch -d $_pkgfn/src/quick/scenegraph -p1 < tacit-text/tacit-text-gamma.patch
}

build() {
	cmake -B build -S $_pkgfn -G Ninja \
		-DCMAKE_MESSAGE_LOG_LEVEL=STATUS \
		-DCMAKE_CXX_FLAGS="$CXXFLAGS -ffat-lto-objects"
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -d "$pkgdir"/usr/share/licenses
	ln -s /usr/share/licenses/qt6-base "$pkgdir"/usr/share/licenses/$pkgname
}
